license: MIT
version: 1.0.0
keywords:
  - "structural credit model"
  - "perpetual preferred equity"
  - "Bitcoin"
  - "Bitcoin Coverage Years (BCY)"
  - "Distance-to-Coverage-Breach (DCB)"
  - "first-passage time"
  - "Black and Cox (1976)"
  - "credit risk"
  - "quantitative finance"
